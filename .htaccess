DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # En la raiz, una eleccion manual previa tiene prioridad.
  RewriteCond %{REQUEST_URI} ^/$
  RewriteCond %{HTTP:Cookie} (?:^|;\s*)alcanox_language=(es|en)(?:;|$) [NC]
  RewriteRule ^$ /%1/ [R=302,L]

  # Sin preferencia guardada: espanol solo cuando es el idioma principal.
  RewriteCond %{REQUEST_URI} ^/$
  RewriteCond %{HTTP:Accept-Language} ^\s*es(?:[-_]|[,;]|$) [NC]
  RewriteRule ^$ /es/ [R=302,L]

  # El resto del trafico recibe ingles. La query (incluido UTM) se conserva.
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header append Vary Accept-Encoding
  Header set X-Content-Type-Options "nosniff"
</IfModule>
